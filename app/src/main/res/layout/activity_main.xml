<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_stage_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panelSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_file_text"
            app:tint="@color/accentBlue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/titleText"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/documentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bodyText"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openDocumentButton"
            style="@style/Widget.OrgistaOpenPdf.PillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_pdf"
            app:icon="@drawable/ic_upload"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeDocumentButton"
            style="@style/Widget.OrgistaOpenPdf.DangerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/close"
            android:visibility="gone"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panelStroke" />

    <HorizontalScrollView
        android:id="@+id/toolbarBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panelSurface"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousPageButton"
                style="@style/Widget.OrgistaOpenPdf.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/previous"
                android:enabled="false"
                app:icon="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/info_chip_bg"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:text="@string/page_placeholder"
                android:textColor="@color/titleText"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextPageButton"
                style="@style/Widget.OrgistaOpenPdf.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/next"
                android:enabled="false"
                app:icon="@drawable/ic_chevron_right" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="@color/chipStroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookmarkButton"
                style="@style/Widget.OrgistaOpenPdf.ReaderChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:minWidth="0dp"
                android:text="@string/bookmark"
                app:icon="@drawable/ic_bookmark_outline"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/panelText" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomOutButton"
                style="@style/Widget.OrgistaOpenPdf.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/zoom_out"
                android:enabled="false"
                app:icon="@drawable/ic_zoom_out" />

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/info_chip_bg"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:text="@string/zoom_placeholder"
                android:textColor="@color/titleText"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomInButton"
                style="@style/Widget.OrgistaOpenPdf.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/zoom_in"
                android:enabled="false"
                app:icon="@drawable/ic_zoom_in" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="@color/chipStroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeToggleButton"
                style="@style/Widget.OrgistaOpenPdf.RoundIconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/theme_dark"
                android:minWidth="0dp"
                app:icon="@drawable/ic_moon" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panelStroke"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/window_stage_bg">

        <FrameLayout
            android:id="@+id/viewerStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <FrameLayout
                android:id="@+id/viewerPanel"
                android:layout_width="640dp"
                android:layout_height="400dp"
                android:layout_gravity="center"
                android:background="@drawable/viewer_panel_bg"
                android:elevation="8dp"
                android:padding="18dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pdfPageImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/pdf_page"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/mainLoadingSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/viewer_loading_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="180dp"
                        android:layout_height="20dp"
                        android:background="@drawable/skeleton_rounded_pill" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="20dp"
                        android:layout_weight="1"
                        android:background="@drawable/skeleton_panel_block" />

                    <View
                        android:layout_width="140dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/skeleton_rounded_pill" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/empty_state_badge_bg"
                    android:contentDescription="@null"
                    android:padding="24dp"
                    android:src="@drawable/ic_file_text"
                    app:tint="@color/accentBlue" />

                <TextView
                    android:id="@+id/welcomeTitleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/welcome_title"
                    android:textColor="@color/titleText"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/welcomeCaptionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/welcome_caption"
                    android:textColor="@color/bodyText"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyStateOpenButton"
                    style="@style/Widget.OrgistaOpenPdf.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/select_pdf_file"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/panelSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_size_placeholder" />

        <Button
            android:id="@+id/openSidePanelButton"
            style="@style/Widget.OrgistaOpenPdf.ReaderChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_panel" />

        <SeekBar
            android:id="@+id/panelWidthSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="72" />

        <SeekBar
            android:id="@+id/panelHeightSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="76" />
    </LinearLayout>

</LinearLayout>
