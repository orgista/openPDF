<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OrgistaOpenPdf" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accentBlue</item>
        <item name="colorPrimaryVariant">@color/accentBlueDark</item>
        <item name="colorOnPrimary">@color/buttonOnPrimary</item>
        <item name="colorSecondary">@color/accentBlueSoft</item>
        <item name="colorOnSecondary">@color/accentBlue</item>
        <item name="colorSurface">@color/panelSurface</item>
        <item name="colorOnSurface">@color/panelText</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/stageBottom</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@drawable/window_stage_bg</item>
    </style>

    <style name="Theme.OrgistaOpenPdf.SidePanel" parent="Theme.OrgistaOpenPdf">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Widget.OrgistaOpenPdf.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accentBlue</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/buttonOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/buttonOnPrimary</item>
        <item name="rippleColor">@color/accentBlueDark</item>
    </style>

    <style name="Widget.OrgistaOpenPdf.DangerButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accentRed</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/buttonOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/accentRedSoft</item>
    </style>

    <style name="Widget.OrgistaOpenPdf.GhostButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/panelText</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/chipFill</item>
    </style>

    <style name="Widget.OrgistaOpenPdf.ReaderChip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/panelText</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/chipFill</item>
    </style>

    <style name="Widget.OrgistaOpenPdf.IconButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/panelText</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="rippleColor">@color/chipFill</item>
    </style>

    <style name="Widget.OrgistaOpenPdf.RoundIconButton" parent="Widget.OrgistaOpenPdf.IconButton">
        <item name="cornerRadius">999dp</item>
    </style>
</resources>
